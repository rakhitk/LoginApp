@page "/login"
@inject NavigationManager Nav

<h3>Login</h3>

<input @bind="username" placeholder="Username" id="username" data-testid="username" />
<br />
<input type="password" @bind="password" placeholder="Password" id="password" data-testid="password" />
<br />
<button @onclick="HandleLogin" id="loginBtn" data-testid="login-btn">Login</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p style="color:red">@errorMessage</p>
}

@code {
    string? username;
    string? password;
    string? errorMessage;

    void HandleLogin()
    {
        Console.WriteLine("Login clicked"); // 👈 DEBUG

        if (username == "admin" && password == "1234")
        {
            Console.WriteLine("Login success");
            Nav.NavigateTo("/dashboard", forceLoad: true);
        }
        else
        {
            errorMessage = "Invalid credentials";
        }
    }
}